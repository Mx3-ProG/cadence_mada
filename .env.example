SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# Client admin côté serveur (service role, contourne les RLS) — requis pour la
# facturation Stripe et l'envoi des notifications de réponse d'invitation.
SUPABASE_SERVICE_ROLE_KEY=""
# Secret aléatoire dédié au HMAC des codes de connexion (openssl rand -hex 32).
# Si absent, la service role key est utilisée comme repli.
TWO_FACTOR_PEPPER=""

# Envoi d'emails transactionnels (codes de connexion, invitations de rendez-vous,
# notifications d'acceptation/refus) — voir supabase/emails/ pour les templates.
# Clé API : https://resend.com/api-keys — le domaine d'expédition doit être
# vérifié dans le dashboard Resend (DNS DKIM/SPF) pour cadencemada.com.
RESEND_API_KEY=""
RESEND_FROM="Cadence Mada <rdv@cadencemada.com>"

# Facturation Stripe (abonnement plan Pro) — src/lib/stripe.server.ts,
# src/lib/billing.functions.ts, src/routes/api/public/stripe/webhook.ts.
# Clé secrète : dashboard Stripe → Developers → API keys (sk_live_... / sk_test_...).
STRIPE_SECRET_KEY=""
# Signing secret du endpoint webhook : dashboard Stripe → Developers → Webhooks
# → endpoint https://cadencemada.com/api/public/stripe/webhook → Signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=""
# ID du PRIX récurrent (price_..., pas l'ID du produit prod_...) : dashboard Stripe
# → Product catalog → le produit → section Pricing → copier l'API ID du prix.
# Si vide, un prix par défaut (10€/mois) est utilisé en fallback.
STRIPE_PRICE_ID=""
